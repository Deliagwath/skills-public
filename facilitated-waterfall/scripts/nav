#!/bin/sh
# nav: where code is defined, and which live docs govern it, in one workspace.
#
# One tags file per workspace, at <git-common-dir>/nav/tags, regenerated lazily
# when the file listing or any listed file changes. Code definitions come from
# Universal Ctags when it is found, else from a keyword grep. Doc mentions (the
# backticked names in Markdown) are indexed by awk either way. Sealed docs
# (closed probes, ledgered Plans, superseded ADRs, archive/) and research are
# indexed as lookup-only. nav reads the workspace and writes nothing but its
# own state directory. It reports budgets; it never enforces them.
#
# Both directions read one link table, built at regeneration. A mention links
# to code only on evidence: an anchor (`Sym` (path), a qualified name, an exact
# path) or a unique identifier-shaped name outside tests. Code that cites a doc
# ("ADR 0042") links the other way. Everything else stays unlinked, with its
# reason, and is counted rather than guessed.
set -eu
LC_ALL=C
export LC_ALL
SELF=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")

usage() {
	cat <<'EOF'
usage: nav [-C dir] [--budget TOKENS] [--role bottom-up|top-down] <query> [args]
  def <symbol>                       where it is defined (docs -> code)
  docs <symbol|path> [--type T,..] [--sealed] [--unlinked]
                                     live docs linked to it (code -> docs)
  docs D-NNN|X-NNN                   a docs/PRODUCT.md entry, and the docs citing
                                     it as PRODUCT.md#D-NNN
  module <path> [--kind K]           definitions under a path, and the docs on them
  file <path>                        a file's definitions, and the docs on them
  unresolved                         live-doc mentions that resolve to nothing
  trace <artifact>                   intent trace up `relates`
The budget is --budget, else $AGENT_CONTEXT_TOKENS (the raw context window);
the share is 10% for bottom-up (default) and 20% for top-down.
Universal Ctags is used when found; NAV_CTAGS=<path> picks one, NAV_CTAGS=none
forces the grep fallback.
EOF
}

die() {
	echo "nav: $*" >&2
	exit 2
}

# --- Arguments ---

C=
BUDGET=${AGENT_CONTEXT_TOKENS:-}
ROLE=bottom-up
while [ $# -gt 0 ]; do
	case $1 in
	-C) [ $# -ge 2 ] || die "-C needs a directory"; C=$2; shift 2 ;;
	--budget) [ $# -ge 2 ] || die "--budget needs a token count"; BUDGET=$2; shift 2 ;;
	--role) [ $# -ge 2 ] || die "--role needs a value"; ROLE=$2; shift 2 ;;
	-h | --help) usage; exit 0 ;;
	-*) usage >&2; exit 2 ;;
	*) break ;;
	esac
done
[ $# -ge 1 ] || { usage >&2; exit 2; }
Q=$1
shift
TYPES= SEALED=0 UNLINKED=0 KIND= ARG=
while [ $# -gt 0 ]; do
	case $1 in
	--type) [ $# -ge 2 ] || die "--type needs a value"; TYPES=$2; shift 2 ;;
	--sealed) SEALED=1; shift ;;
	--unlinked) UNLINKED=1; shift ;;
	--kind) [ $# -ge 2 ] || die "--kind needs a value"; KIND=$2; shift 2 ;;
	-*) die "unknown option: $1" ;;
	*) [ -z "$ARG" ] || die "$Q takes one argument"; ARG=$1; shift ;;
	esac
done
case $Q in
def | docs | module | file | trace) [ -n "$ARG" ] || die "$Q needs an argument" ;;
unresolved) ;;
*) usage >&2; exit 2 ;;
esac
case $BUDGET in *[!0-9]*) die "budget must be a token count: $BUDGET" ;; esac
case $ROLE in
bottom-up) PCT=10 ;;
top-down) PCT=20 ;;
*) die "role is bottom-up or top-down: $ROLE" ;;
esac

# --- Workspace: the git root of the queried path, never a guess (D17) ---

BASE=${C:-.}
[ -d "$BASE" ] || die "no such directory: $BASE"
BASE=$(cd "$BASE" && pwd -P)

TARGET=
case $Q in
module | file | trace) TARGET=$ARG ;;
docs) case $ARG in */*) TARGET=$ARG ;; esac ;;
esac

START=$BASE TABS=
if [ -n "$TARGET" ]; then
	case $TARGET in /*) t=$TARGET ;; *) t=$BASE/$TARGET ;; esac
	if [ -d "$t" ]; then
		TABS=$(cd "$t" && pwd -P)
		START=$TABS
	elif [ -e "$t" ]; then
		START=$(cd "$(dirname "$t")" && pwd -P)
		TABS=$START/$(basename "$t")
	fi
fi

GIT=0
if ROOT=$(git -C "$START" rev-parse --show-toplevel 2>/dev/null); then
	GIT=1
	ROOT=$(cd "$ROOT" && pwd -P)
elif [ -n "$C" ]; then
	ROOT=$BASE
else
	echo "nav: $START is not inside a git workspace; name one with -C or a path." >&2
	found=0
	for d in "$BASE"/*/; do
		[ -e "$d.git" ] || continue
		[ "$found" = 1 ] || echo "candidates:" >&2
		found=1
		echo "  ${d%/}" >&2
	done
	exit 3
fi

# The target, relative to the workspace root.
REL=
if [ -n "$TABS" ]; then
	case $TABS in
	"$ROOT") REL= ;;
	"$ROOT"/*) REL=${TABS#"$ROOT"/} ;;
	*) die "$TARGET is outside workspace $ROOT" ;;
	esac
elif [ -n "$TARGET" ]; then
	REL=${TARGET#./}
fi

if [ "$GIT" = 1 ]; then
	GCD=$(git -C "$ROOT" rev-parse --git-common-dir)
	case $GCD in /*) ;; *) GCD=$ROOT/$GCD ;; esac
	STATE=$GCD/nav
else
	h=$(printf '%s' "$ROOT" | cksum | cut -d' ' -f1)
	STATE=${XDG_CACHE_HOME:-$HOME/.cache}/nav/$h
fi
mkdir -p "$STATE"
cd "$ROOT"

# --- Tools: Universal Ctags only; Apple's BSD ctags shadows it on PATH (F10) ---

is_uctags() { [ -x "$1" ] && "$1" --version 2>/dev/null | grep -q 'Universal Ctags'; }

find_ctags() {
	case ${NAV_CTAGS:-} in
	none) return 1 ;;
	'') ;;
	*) is_uctags "$NAV_CTAGS" && { echo "$NAV_CTAGS"; return 0; }; return 1 ;;
	esac
	oifs=$IFS
	IFS=:
	for d in $PATH /opt/homebrew/bin /usr/local/bin /home/linuxbrew/.linuxbrew/bin; do
		for n in ctags uctags universal-ctags; do
			if is_uctags "$d/$n"; then
				IFS=$oifs
				echo "$d/$n"
				return 0
			fi
		done
	done
	IFS=$oifs
	return 1
}

if CTAGS=$(find_ctags); then MODE=ctags; else MODE=grep CTAGS=; fi

# --- Shared awk ---

# Prints "FILENAME<TAB>item" for each item of frontmatter list key `key`,
# written inline ([a, b]), as a scalar, or as a block list.
AWK_FMLIST='
function emit(v) {
	gsub(/^[ \t"\047]+|[ \t"\047]+$/, "", v)
	if (v != "") print FILENAME "\t" v
}
FNR == 1 { infm = ($0 == "---"); inkey = 0; if (!infm) nextfile; next }
infm && $0 == "---" { nextfile }
infm {
	if (inkey && $0 ~ /^[ \t]*-[ \t]+/) { v = $0; sub(/^[ \t]*-[ \t]+/, "", v); emit(v); next }
	inkey = 0
	if (index($0, key ":") == 1) {
		v = substr($0, length(key) + 2); sub(/^[ \t]+/, "", v); sub(/[ \t]+#.*$/, "", v)
		if (v == "") { inkey = 1; next }
		if (v ~ /^\[/) {
			sub(/^\[/, "", v); sub(/\][ \t]*$/, "", v)
			n = split(v, a, ",")
			for (i = 1; i <= n; i++) emit(a[i])
		} else emit(v)
	}
}'

# Doc-side tags: artifact ids and backticked mentions, kind by seal class.
AWK_DOCTAGS='
BEGIN { FS = "\t" }
FILENAME == sealedf { cls[$1] = $2; next }
FNR == 1 {
	c = (FILENAME in cls) ? cls[FILENAME] : "live"
	mk = (c == "live") ? "mention" : c
	ak = (c == "live") ? "artifact" : "sealedartifact"
	infm = ($0 == "---")
	if (infm) next
}
infm && $0 == "---" { infm = 0; next }
infm && /^id:[ \t]*/ { v = $0; sub(/^id:[ \t]*/, "", v); gsub(/["\047]/, "", v); print v "\t" FILENAME "\t" FNR ";\"\tkind:" ak "\tline:" FNR; next }
{
	s = $0
	while (match(s, /`[A-Za-z_][A-Za-z0-9_.\/-]*[A-Za-z0-9_](\(\))?`/)) {
		t = substr(s, RSTART + 1, RLENGTH - 2); sub(/\(\)$/, "", t)
		s = substr(s, RSTART + RLENGTH)
		# An anchor hint right after the mention: `Sym` (path), (`path`), (path:line).
		h = ""
		if (match(s, /^ \(`?[A-Za-z0-9_.\/-]+(:[0-9,-]+)?`?\)/)) {
			h = substr(s, 3, RLENGTH - 3); gsub(/`/, "", h); sub(/:[0-9,-]+$/, "", h); sub(/^\.\//, "", h)
		}
		print t "\t" FILENAME "\t" FNR ";\"\tkind:" mk "\tline:" FNR (h != "" ? "\thint:" h : "")
	}
}'

# Code-side tags for the grep fallback: a keyword definition heuristic.
DEFRE='(^|[^A-Za-z0-9_])(def|class|function|func|fn|sub|type|interface|struct|enum|trait|module|const)[[:space:]]+[A-Za-z_]|^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(\)[[:space:]]*\{?'
AWK_GREPDEFS='
{
	p = index($0, ":"); path = substr($0, 1, p - 1); r = substr($0, p + 1)
	p = index(r, ":"); line = substr(r, 1, p - 1); r = substr(r, p + 1)
	if (match(r, /(def|class|function|func|fn|sub|type|interface|struct|enum|trait|module|const)[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
		s = substr(r, RSTART, RLENGTH); n = split(s, w, /[ \t]+/); name = w[n]; k = w[1]
	} else if (match(r, /^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*\(\)/)) {
		s = substr(r, RSTART, RLENGTH); gsub(/[ \t()]/, "", s); name = s; k = "function"
	} else next
	print name "\t" path "\t" line ";\"\tkind:" k "\tline:" line
}'

# Common field access and doc ranking, prepended to the query programs.
AWK_LIB='
function fld(name,  i) { for (i = 4; i <= NF; i++) if (index($i, name ":") == 1) return substr($i, length(name) + 2); return "" }
function isdoc(k) { return k == "mention" || k == "artifact" || islookup(k) }
function islookup(k) { return k == "history" || k == "research" || k == "sealedartifact" }
function lastseg(s) { sub(/.*[.\/]/, "", s); return s }
function base(s) { sub(/.*\//, "", s); return s }
function under(f, p) { return p == "" || f == p || index(f, p "/") == 1 }
function linked(c) { return c == "anchored" || c == "unique" || c == "cited" }
'

# The link table: every doc mention resolved once, on evidence only (F28-F34).
# Output: src, srcline, name, class, target file, target name, target line, tier.
# Linked classes are anchored, unique and cited; any other class is a reason
# the mention was left unlinked. Inputs: the listing, then the tags.
AWK_LINKS='
function testfile(f) { return f ~ /(^|\/)(tests?|testing|__tests__|spec|fixtures?)\// || base(f) ~ /^test_|_test\.|\.test\.|\.spec\./ }
function shaped(m) { return m ~ /[_.]/ || m ~ /[a-z][A-Z]/ || m ~ /^[A-Z][a-z0-9]+[A-Z]/ }
function noext(s) { s = base(s); sub(/\.[^.]*$/, "", s); return s }
function first(l,  a) { split(l, a, SUBSEP); return a[2] }
function out(c, tf, tn, tl) { print ms[i] "\t" ml[i] "\t" m "\t" c "\t" tf "\t" tn "\t" tl "\t" mt[i] }
# Of the files defining name n, those under hint path h (or named h).
function inhint(n, h,  a, j, k, c) {
	c = 0; k = split(files[n], a, SUBSEP)
	for (j = 2; j <= k; j++) if (under(a[j], h) || base(a[j]) == h || (length(a[j]) > length(h) && substr(a[j], length(a[j]) - length(h)) == "/" h)) { c++; hf = a[j] }
	return c
}
# Reads of nf[] create the key in awk, so "is defined" is always nf[x] > 0, never `x in nf`.
function resolve(  key, h, a1, a1l, b1, a, j, k, c, tf) {
	h = mh[i]
	if (m in path) return out("anchored", m, "", 1)
	if (m in dir) return out("anchored", m, "", "")
	if (m ~ /\// && suf[m] == 1) return out("anchored", sufp[m], "", 1)
	if (m ~ /\// || (m ~ /\.[A-Za-z][A-Za-z0-9]*$/ && (m in bc))) {
		if (bc[base(m)] == 1) return out("unique", bp[base(m)], "", 1)
		if (bc[base(m)] > 1) return out("ambiguous", "", "", "")
		if (m ~ /\//) return out("no-definition", "", "", "")
	}
	if (h != "") {
		key = (nf[m] > 0) ? m : lastseg(m)
		if (!(nf[key] > 0)) return out("hint-miss", "", "", "")
		c = inhint(key, h)
		if (c == 1) return out("anchored", hf, key, def[key, hf])
		return out(c == 0 ? "hint-miss" : "ambiguous", "", "", "")
	}
	# A dotted name: a qualified definition, the class and member in one file,
	# or a module of that name (its file, or its package __init__). Without a
	# hint, an anchor never lands in a test file.
	if (m ~ /\./) {
		tf = ""
		a1 = m; sub(/\.[^.]*$/, "", a1); b1 = m; sub(/.*\./, "", b1); a1l = a1; sub(/.*\./, "", a1l)
		if (nf[m] == 1) { tf = first(files[m]); tn = m }
		else if (nf[a1] == 1 && ((b1, first(files[a1])) in def)) { tf = first(files[a1]); tn = b1 }
		else if (nf[b1] > 0) {
			c = 0; k = split(files[b1], a, SUBSEP)
			for (j = 2; j <= k; j++) if (noext(a[j]) == a1l || a[j] ~ ("(^|/)" a1l "/__init__\\.py$")) { c++; f1 = a[j] }
			if (c == 1) { tf = f1; tn = b1 }
		}
		if (tf != "") return testfile(tf) ? out("test-only", "", "", "") : out("anchored", tf, tn, def[tn, tf])
	}
	if (nf[m] == 1) {
		tf = first(files[m])
		if (testfile(tf)) return out("test-only", "", "", "")
		if (!shaped(m)) return out("plain-word", "", "", "")
		return out("unique", tf, m, def[m, tf])
	}
	if (nf[m] > 1 || (lastseg(m) != m && nf[lastseg(m)] > 0)) return out("ambiguous", "", "", "")
	return out("no-definition", "", "", "")
}
FILENAME == ARGV[1] {
	path[$0] = 1; b = base($0); bc[b]++; bp[b] = $0
	s = $0; while ((p = index(s, "/")) > 0) { s = substr(s, p + 1); if (s != b) { suf[s]++; sufp[s] = $0 } }
	d = $0; while (sub(/\/[^\/]*$/, "", d)) dir[d] = 1
	next
}
/^!_/ { next }
{ k = fld("kind") }
k == "file" || k == "artifact" || k == "sealedartifact" { next }
k == "mention" || k == "history" || k == "research" {
	nm++; mn[nm] = $1; ms[nm] = $2; ml[nm] = fld("line"); mh[nm] = fld("hint"); mt[nm] = (k == "mention") ? "live" : "lookup"
	next
}
!(($1, $2) in def) { def[$1, $2] = fld("line"); files[$1] = files[$1] SUBSEP $2; nf[$1]++ }
END { for (i = 1; i <= nm; i++) { m = mn[i]; resolve() } }
'

# Code citing docs: "ADR 0042", "Task 057", "docs/adr/....md". Inputs: the
# listing, the sealed list, then `grep -noE` output (path:line:match).
CITERE='(ADR|Task|Plan|Epic|Direction|Story)[ -]?[0-9]{2,4}|docs/[A-Za-z0-9_./-]+\.md'
AWK_CITES='
function emit(d) { print f "\t" l "\t" m "\tcited\t" d "\t\t\t" ((d in sealed) ? "lookup" : "live") }
FILENAME == ARGV[1] {
	path[$0] = 1
	if ($0 ~ /^docs\/(adr|tasks|plans|epics|directions|product\/(epics|directions|stories))\/[0-9]+[^\/]*$/) {
		ty = $0; sub(/^docs\//, "", ty); sub(/\/[^\/]*$/, "", ty)
		n = base($0); sub(/[^0-9].*/, "", n); key = ty "/" (n + 0); cnt[key]++; doc[key] = $0
	}
	next
}
FILENAME == ARGV[2] { split($0, a, "\t"); sealed[a[1]] = 1; next }
{
	p = index($0, ":"); f = substr($0, 1, p - 1); r = substr($0, p + 1)
	p = index(r, ":"); l = substr(r, 1, p - 1); m = substr(r, p + 1)
	if (m ~ /^docs\//) { if (m in path) emit(m); next }
	ty = m; sub(/[ -]*[0-9]+$/, "", ty); n = m; sub(/^[^0-9]*/, "", n); n += 0
	tl = (ty == "ADR") ? "adr" : (ty == "Task") ? "tasks" : (ty == "Plan") ? "plans" : (ty == "Epic") ? "epics product/epics" : (ty == "Direction") ? "directions product/directions" : "product/stories"
	k = split(tl, t, " "); c = 0
	for (j = 1; j <= k; j++) { key = t[j] "/" n; if (cnt[key] == 1) { c++; d = doc[key] } else if (cnt[key] > 1) c += 2 }
	if (c == 1) emit(d)
}
'

# --- Listing and freshness (D8) ---

T=$STATE/tmp.$$
mkdir -p "$T"
: >"$T/hb"
trap 'rm -rf "$T"' EXIT INT TERM

if [ "$GIT" = 1 ]; then
	{
		git -c core.quotePath=false ls-files -co --exclude-standard
		if [ -d docs ]; then find docs -type f ! -name .DS_Store; fi
	} | grep -v '/$' | sort -u >"$T/all"
	{
		git -c core.quotePath=false ls-files -d
		git -c core.quotePath=false ls-files -s | awk '$1 == "160000" { sub(/^[^\t]*\t/, ""); print }'
	} >"$T/drop"
	if [ -s "$T/drop" ]; then grep -vxF -f "$T/drop" "$T/all" >"$T/listing" || :; else mv "$T/all" "$T/listing"; fi
else
	find . -name .git -prune -o -type f ! -name .DS_Store -print | sed 's#^\./##' | sort >"$T/listing"
fi
SUM=$(cksum <"$T/listing")

fresh=1
[ -f "$STATE/tags" ] && [ -f "$STATE/links" ] && [ -f "$STATE/stamp" ] || fresh=0
[ "$fresh" = 0 ] || [ "$(cat "$STATE/mode" 2>/dev/null)" = "$MODE" ] || fresh=0
[ "$fresh" = 0 ] || [ "$(cat "$STATE/listing.sum" 2>/dev/null)" = "$SUM" ] || fresh=0
# A newer nav means newer rules: state built by an older one is stale.
[ "$fresh" = 0 ] || [ -z "$(find "$SELF" -newer "$STATE/stamp" 2>/dev/null)" ] || fresh=0
if [ "$fresh" = 1 ]; then
	newer=$(tr '\n' '\0' <"$T/listing" |
		xargs -0 sh -c 'find "$@" -prune -newer "$0" -print' "$STATE/stamp" 2>/dev/null |
		head -n 1) || :
	[ -z "$newer" ] || fresh=0
fi

xfiles() { # xfiles <list> <cmd...>: run cmd over the files in list (never on stdin)
	l=$1
	shift
	tr '\n' '\0' <"$l" | xargs -0 "$@" /dev/null
}

regen() {
	: >"$T/stamp" # the start time: an edit made during regeneration is seen next call
	grep '\.md$' "$T/listing" >"$T/md" || :
	grep -v -E '\.(md|markdown|rst|txt|json|lock|csv|tsv|svg|png|jpe?g|gif|ico|pdf|min\.js|map)$' "$T/listing" >"$T/code" || :

	# Sealed set, derived from disk (D2; F20, F22).
	{
		grep -E '(^|/)probes/[^/]+\.md$' "$T/md" >"$T/probes" || :
		xfiles "$T/probes" awk '
			FNR == 1 { infm = ($0 == "---"); if (!infm) nextfile; next }
			infm && $0 == "---" { nextfile }
			infm && /^status:/ {
				v = $0; sub(/^status:[ \t]*/, "", v); gsub(/["\047 \t]/, "", v)
				if (v == "reconciled" || v == "abandoned" || v == "resolved") print FILENAME "\thistory"
				nextfile
			}'
		if [ -f docs/plans/LEDGER.md ]; then
			awk '{ sub(/^[ \t]*[-*][ \t]+/, ""); gsub(/`/, ""); if ($1 != "") print $1 }' docs/plans/LEDGER.md >"$T/ledger"
			grep -E '^docs/plans/[^/]+\.md$' "$T/md" | grep -v '/LEDGER\.md$' |
				awk 'FILENAME == ARGV[1] { k[$0] = 1; next }
					{ b = $0; sub(/.*\//, "", b); s = b; sub(/\.md$/, "", s)
					  if (($0 in k) || (b in k) || (s in k)) print $0 "\thistory" }' "$T/ledger" - || :
		fi
		grep -E '^docs/adr/[^/]+\.md$' "$T/md" >"$T/adrs" || :
		xfiles "$T/adrs" awk -v key=supersedes "$AWK_FMLIST" >"$T/adrsup"
		awk -F'\t' 'FILENAME == ARGV[1] { b = $2; sub(/.*\//, "", b); sub(/\.md$/, "", b); if (b != "") sup[b] = 1; next }
			{ b = $0; sub(/.*\//, "", b); sub(/\.md$/, "", b); if (b in sup) print $0 "\thistory" }' "$T/adrsup" "$T/adrs"
		grep -E '(^|/)archive/' "$T/md" | sed 's/$/	history/' || :
		grep -E '^docs/(knowledge|research)/' "$T/md" | sed 's/$/	research/' || :
	} | sort -t '	' -k1,1 -u >"$T/sealed"

	# Doc sizes, for the budget readout.
	xfiles "$T/md" wc -c | awk '{ n = $1; sub(/^[ \t]*[0-9]+[ \t]+/, ""); if ($0 != "total" && $0 != "/dev/null") print $0 "\t" n }' >"$T/sizes"

	# Tags: code definitions, then doc mentions; one sorted file.
	if [ "$MODE" = ctags ]; then
		"$CTAGS" --options=NONE --extras=+qf --fields=+nKzSesait --excmd=number --sort=no \
			-L "$T/code" -f "$T/code.tags" 2>/dev/null || :
	else
		{
			xfiles "$T/code" grep -nE "$DEFRE" 2>/dev/null | awk "$AWK_GREPDEFS" || :
			awk '{ print $0 "\t" $0 "\t1;\"\tkind:file\tline:1" }' "$T/code"
		} >"$T/code.tags"
	fi
	xfiles "$T/md" awk -v sealedf="$T/sealed" "$AWK_DOCTAGS" "$T/sealed" >"$T/doc.tags"
	{
		printf '!_TAG_FILE_FORMAT\t2\t/extended format/\n'
		printf '!_TAG_FILE_SORTED\t1\t/0=unsorted, 1=sorted, 2=foldcase/\n'
		printf '!_TAG_PROGRAM_NAME\tnav\t/%s/\n' "$MODE"
		cat "$T/code.tags" "$T/doc.tags" | grep -v '^!_' | sort
	} >"$T/tags"

	# Links: doc mentions resolved on evidence, then code citing docs.
	awk -F'\t' "$AWK_LIB$AWK_LINKS" "$T/listing" "$T/tags" >"$T/links"
	{ xfiles "$T/code" grep -noE "$CITERE" 2>/dev/null || :; } |
		awk -F'\t' "$AWK_LIB$AWK_CITES" "$T/listing" "$T/sealed" - >>"$T/links"

	# Into place; the stamp goes last, so an interrupted run is never fresh.
	for f in tags sealed sizes adrsup listing links; do mv "$T/$f" "$STATE/$f"; done
	echo "$MODE" >"$STATE/mode"
	echo "$SUM" >"$STATE/listing.sum"
	mv "$T/stamp" "$STATE/stamp"
}

REGEN=
if [ "$fresh" = 0 ]; then
	regen
	REGEN=" · regenerated"
fi
TAGS=$STATE/tags

LAYER=$MODE
[ "$MODE" = ctags ] || LAYER="grep fallback"
echo "nav $Q${ARG:+ $ARG} · $ROOT · $LAYER$REGEN"

# --- Output: the summary (budget, handbook, always), then ranked docs by tier ---
# The summary comes first so it survives a caller's `| head`; sessions truncate.

# Input records: rank<TAB>hits<TAB>path<TAB>lines<TAB>live|lookup<TAB>classes
render() {
	sort -t '	' -k1,1n -k2,2nr -k3,3 | awk -F'\t' \
		-v sealed="$SEALED" -v budget="$BUDGET" -v pct="$PCT" -v role="$ROLE" \
		-v sizesf="$STATE/sizes" -v supf="$STATE/adrsup" -v hbf="$T/hb" '
	function tok(b) { return int(b / 4 + 0.5) }
	function rng(b,  lo) { lo = tok(b); return "~" lo "–" 2 * lo " tok" }
	BEGIN {
		while ((getline l < sizesf) > 0) { split(l, a, "\t"); size[a[1]] = a[2] }
		while ((getline l < supf) > 0) { split(l, a, "\t"); sup[a[1]] = sup[a[1]] " " a[2] }
	}
	$5 == "lookup" {
		lk++; lkh += $2
		if (sealed) lrows = lrows sprintf("lookup    %-52s %-14s (%d) %s\n", $3, ($4 != "" ? $4 : "-"), $2, $6)
		next
	}
	{
		n++
		if (n > 20) { more++; next }
		on += size[$3]
		rows = rows sprintf("on-match  %-52s %-14s (%d) %s  %s\n", $3, ($4 != "" ? $4 : "-"), $2, $6, rng(size[$3]))
		if ($3 in sup) {
			k = split(sup[$3], s, " ")
			for (i = 1; i <= k; i++) rows = rows sprintf("          supersedes %s (lookup)\n", s[i])
		}
	}
	END {
		hb = "docs/handbook/index.md"
		if (hb in size) al = size[hb]
		tot = on + al
		if (budget == "") printf "budget    unset (AGENT_CONTEXT_TOKENS or --budget): always + on-match %s\n", rng(tot)
		else {
			share = int(budget * pct / 100)
			v = (2 * tok(tot) <= share) ? "within share" : (tok(tot) <= share ? "may exceed share: read on-match by rank" : "over share: trim on-match")
			printf "budget    always + on-match %s of %d tok (%s %d%% of %d) · %s\n", rng(tot), share, role, pct, budget, v
		}
		handbook()
		if (hb in size) printf "always    %-52s %s\n", hb, rng(al)
		printf "%s", rows
		if (n == 0) print "on-match  none"
		if (more) printf "on-match  +%d more docs, ranked lower (narrow with --type)\n", more
		printf "%s", lrows
		if (lk && !sealed) printf "lookup    %d links in %d sealed or research docs (--sealed lists them)\n", lkh, lk
	}
	# The handbook entries linked into this answer: each linked line counts the
	# "### " entry that holds it, once. Their size is held against a quarter of
	# the role share (D20); over it, the cut test is due at the next close.
	function handbook(  l, a, f, i, n, e, eb, hit, ne, nf, b, hshare) {
		while ((getline l < hbf) > 0) { split(l, a, "\t"); want[a[1], a[2]] = 1; if (!(a[1] in hf)) { hf[a[1]] = 1; fo[++nf] = a[1] } }
		if (!nf) return
		for (i = 1; i <= nf; i++) {
			f = fo[i]; n = 0; e = 0; eb = 0; hit = 0
			while ((getline l < f) > 0) {
				n++
				if (l ~ /^#{1,3} /) { if (hit) { ne++; b += eb }; e = (l ~ /^### /); eb = 0; hit = 0 }
				if (e) { eb += length(l) + 1; if ((f, n) in want) hit = 1 }
			}
			if (hit) { ne++; b += eb }
			close(f)
		}
		if (budget == "") { printf "handbook  %d entries matched in %d files, %s (budget unset: no size trigger)\n", ne, nf, rng(b); return }
		hshare = int(budget * pct / 400)
		printf "handbook  %d entries matched in %d files, %s of %d tok (1/4 of share) · %s\n", ne, nf, rng(b), hshare, (tok(b) > hshare ? "over: cut test due at close" : "within")
	}'
}

# Doc records from the link table, filtered by --type. A link names its doc:
# the source of a mention, or the target of a citation.
DOCREC='
function rank(p) {
	if (p ~ /(^|\/)LEDGER\.md$/) return 9
	if (p ~ /^docs\/handbook\//) return 1
	if (p ~ /^docs\/adr\//) return 2
	if (p ~ /(^|\/)CONTEXT\.md$/) return 3
	if (p ~ /^docs\/tasks\//) return 4
	if (p ~ /^docs\/epics\//) return 5
	if (p ~ /^docs\/(directions|product)\//) return 6
	if (p ~ /^docs\/plans\//) return 7
	if (p ~ /(^|\/)probes\//) return 8
	return 9
}
function dtype(p,  t) {
	if (p ~ /(^|\/)CONTEXT\.md$/) return "context"
	if (p ~ /^docs\//) { t = substr(p, 6); sub(/\/.*/, "", t); return t }
	return "other"
}
function typeok(p,  n, a, i, t) {
	if (types == "") return 1
	t = dtype(p); n = split(types, a, ",")
	for (i = 1; i <= n; i++) if (index(t, a[i]) == 1) return 1
	return 0
}
function hit(p, line, tier, c) {
	if (!typeok(p)) return
	if (!(p in hits)) { order[++np] = p; cls[p] = tier }
	hits[p]++
	if (!((p, c) in hc)) { hc[p, c] = 1; cl[p] = cl[p] (cl[p] != "" ? "," : "") c }
	if (line != "" && !((p, line) in seenl) && (nl[p] < 50 || p ~ /^docs\/handbook\//)) { seenl[p, line] = 1; ln[p, ++nl[p]] = line + 0 }
}
function lines(p,  i, j, n, v, s) { # the first 6 distinct lines, ascending
	n = nl[p]
	for (i = 2; i <= n; i++) { v = ln[p, i]; for (j = i - 1; j >= 1 && ln[p, j] > v; j--) ln[p, j + 1] = ln[p, j]; ln[p, j + 1] = v }
	for (i = 1; i <= n && i <= 6; i++) s = s (i > 1 ? "," : "L") ln[p, i]
	return s (n > 6 ? ",…" : "")
}
function link() { if ($4 == "cited") hit($5, "", $8, "cited"); else hit($1, $2, $8, $4) }
function flush(out,  i, j, p, r) {
	for (i = 1; i <= np; i++) {
		p = order[i]; r = rank(p) "\t" hits[p] "\t" p "\t" lines(p) "\t" cls[p] "\t" cl[p]
		if (out != "") print r > out; else print r
		# Every handbook line, for the entry count in the footer.
		if (p ~ /^docs\/handbook\// && p != "docs/handbook/index.md")
			for (j = 1; j <= nl[p]; j++) print p "\t" ln[p, j] > hbf
	}
}
# Mentions left unlinked, by reason; listed with --unlinked.
function unlinked(  r) {
	if (!typeok($1)) return
	un++; ur[$4]++; ud[$1]++
	if (showun) printf "unlinked  %s:%s  %s  (%s)\n", $1, $2, $3, $4 > unf
}
function unsummary(what,  r, s, n) {
	if (!un) return
	for (r in ur) s = s (s != "" ? ", " : "") ur[r] " " r
	for (r in ud) n++
	printf "unlinked  %d mentions of %s in %d docs could not be linked (%s)%s\n", un, what, n, s, (showun ? "" : "; --unlinked lists them") > unf
}
'

# --- Queries ---

q_def() {
	awk -F'\t' -v sym="$ARG" "$AWK_LIB"'
	/^!_/ { next }
	{ k = fld("kind"); if (isdoc(k) || k == "file") next }
	$1 == sym { ex[++ne] = $0; next }
	{ if ($1 == lastseg(sym) || (sym !~ /[.]/ && lastseg($1) == sym && $1 ~ /[.]/)) ls[++nls] = $0 }
	function show(r,  e, sc, sg) {
		$0 = r; e = fld("end"); sc = fld("scope"); sg = fld("signature")
		printf "def       %s:%s%s  %s%s%s\n", $2, fld("line"), (e != "" ? "-" e : ""), fld("kind"), (sc != "" ? "  in " sc : ""), (sg != "" ? "  " sg : "")
	}
	END {
		if (ne) { print "layer     exact name"; for (i = 1; i <= ne && i <= 20; i++) show(ex[i]); if (ne > 20) print "def       +" ne - 20 " more"; exit 0 }
		if (nls) { print "layer     last segment"; for (i = 1; i <= nls && i <= 20; i++) show(ls[i]); if (nls > 20) print "def       +" nls - 20 " more"; exit 0 }
		exit 1
	}' "$TAGS" && return 0
	grep -v '\.md$' "$STATE/listing" >"$T/code" || :
	echo "layer     literal grep (no definition found)"
	xfiles "$T/code" grep -nwF -e "$ARG" 2>/dev/null | head -n 20 | sed 's/^/grep      /' || :
	return 0
}

# docs D-NNN | X-NNN: the docs/PRODUCT.md entry (its line, and the row that
# supersedes it), then the docs citing it as `PRODUCT.md#<id>`. A bare id is no
# evidence: other docs number their own decisions the same way (F46).
q_product() {
	pf=docs/PRODUCT.md
	if [ -f "$pf" ]; then
		awk -v id="$ARG" -v pf="$pf" '
		function has(s) { return s ~ ("(^|[^A-Za-z0-9-])" id "([^0-9]|$)") }
		/^\|/ {
			n = split($0, a, "|")
			if (n < 6) next
			if (has(a[2])) row = FNR
			else if (has(a[5]) && match(a[2], /[DX]-[0-9]+/)) by = by (by != "" ? ", " : "") substr(a[2], RSTART, RLENGTH)
			next
		}
		/^[-*][ \t]/ { s = $0; sub(/^[-*][ \t]+(<a [^>]*><\/a>)?/, "", s); if (index(s, id) == 1 && substr(s, length(id) + 1, 1) !~ /[0-9]/) row = FNR }
		END {
			if (!row) { printf "product   %s  not in %s\n", id, pf; exit }
			printf "product   %s  %s:%d  %s\n", id, pf, row, (by != "" ? "superseded by " by : "current")
		}' "$pf"
	else
		echo "product   no $pf in $ROOT"
	fi
	grep '\.md$' "$STATE/listing" | grep -vxF "$pf" >"$T/md" || :
	xfiles "$T/md" grep -nE "PRODUCT\.md#$ARG([^0-9]|\$)" 2>/dev/null |
		awk -F'\t' -v hbf="$T/hb" -v types="$TYPES" "$AWK_LIB$DOCREC"'
		FILENAME == ARGV[1] { sealed[$1] = 1; next }
		{
			p = index($0, ":"); f = substr($0, 1, p - 1); r = substr($0, p + 1)
			hit(f, substr(r, 1, index(r, ":") - 1), (f in sealed) ? "lookup" : "live", "product")
		}
		END { flush() }' "$STATE/sealed" - | render
}

# docs <symbol>: the docs whose links resolve to a definition of that name, in
# a file that defines it. docs <path>: links into the path, and the docs that
# code under the path cites.
q_docs() {
	case $ARG in [DX]-[0-9]*) case $ARG in *[!0-9DX-]*) ;; *) q_product; return 0 ;; esac ;; esac
	pathmode=0
	case $ARG in */*) pathmode=1 ;; esac
	[ -e "$ARG" ] && pathmode=1
	sym=$ARG
	[ "$pathmode" = 0 ] || sym=${REL:-${ARG#./}}
	: >"$T/un"
	awk -F'\t' -v hbf="$T/hb" -v sym="$sym" -v pathmode="$pathmode" -v types="$TYPES" -v showun="$UNLINKED" -v unf="$T/un" "$AWK_LIB$DOCREC"'
	function noext(s) { s = base(s); sub(/\.[^.]*$/, "", s); return s }
	BEGIN { L = lastseg(sym); A = sym; sub(/\.[^.]*$/, "", A); Al = A; sub(/.*\./, "", Al) }
	FILENAME == ARGV[1] {
		if (pathmode || /^!_/) next
		k = fld("kind"); if (isdoc(k) || k == "file") next
		if ($1 == sym) ef[$2] = 1; else if ($1 == L) lf[$2] = 1
		if (sym ~ /\./ && $1 == A) af[$2] = 1
		next
	}
	# No exact definition: a dotted name narrows by its prefix, as the resolver
	# does (same file as the class, or a module of that name).
	FNR == 1 && !pathmode {
		for (f in ef) { have = 1; break }
		if (!have) for (f in lf) if (sym !~ /\./ || (f in af) || noext(f) == Al || index("/" f, "/" Al "/")) ef[f] = 1
	}
	pathmode {
		if ($4 == "cited") { if (under($1, sym)) link(); next }
		if (linked($4) && $5 != "" && under($5, sym)) link()
		next
	}
	linked($4) { if ($4 != "cited" && $6 != "" && lastseg($6) == L && ($5 in ef)) link(); next }
	$3 == sym || ($3 ~ /\./ && lastseg($3) == L) { unlinked() }
	END { flush(); if (!pathmode) unsummary(sym) }' "$TAGS" "$STATE/links" | render
	cat "$T/un"
}

# Shared by module and file: the docs linked into the scope and the docs that
# code in scope cites, then the definitions in scope (last, as the longest part).
q_scope() { # q_scope dir|file
	: >"$T/rec"
	awk -F'\t' -v hbf="$T/hb" -v rel="$REL" -v scope="$1" -v kindf="$KIND" -v types="$TYPES" -v recf="$T/rec" "$AWK_LIB$DOCREC"'
	function inscope(p) {
		if (scope == "file") return p == rel
		return under(p, rel)
	}
	FILENAME == ARGV[1] {
		if (/^!_/) next
		k = fld("kind"); if (isdoc(k) || k == "file" || !inscope($2)) next
		if (kindf != "" && index(k, kindf) != 1) next
		if ($1 ~ /[.]/ && fld("scope") != "") next
		if (!(($2) in nd)) forder[++nf] = $2
		nd[$2]++
		if (nd[$2] <= 8) names[$2] = names[$2] (nd[$2] > 1 ? ", " : "") $1
		if (scope == "file") {
			e = fld("end"); sc = fld("scope")
			printf "def       %s:%s%s  %s%s  %s\n", $1, fld("line"), (e != "" ? "-" e : ""), k, (sc != "" ? "  in " sc : ""), fld("signature")
		}
		next
	}
	function defs(  i, f) {
		if (shown || scope == "file") return
		shown = 1
		for (i = 1; i <= nf && i <= 30; i++) { f = forder[i]; printf "defs      %s  (%d): %s%s\n", f, nd[f], names[f], (nd[f] > 8 ? ", …" : "") }
		if (nf > 30) printf "defs      +%d more files\n", nf - 30
		if (nf == 0) print "defs      none in scope"
	}
	FNR == 1 { defs() }
	$4 == "cited" { if (inscope($1)) link(); next }
	linked($4) && $5 != "" && inscope($5) { link() }
	END { defs(); flush(recf) }' "$TAGS" "$STATE/links" >"$T/defs"
	render <"$T/rec"
	cat "$T/defs"
}

q_module() {
	[ -z "$REL" ] || [ -d "$REL" ] || die "no such directory in $ROOT: $REL"
	q_scope dir
}

q_file() {
	[ -f "$REL" ] || die "no such file in $ROOT: $REL"
	q_scope file
}

q_unresolved() {
	grep -v '\.md$' "$STATE/listing" >"$T/code" || :
	awk -F'\t' "$AWK_LIB"'
	FILENAME == ARGV[1] { path[$0] = 1; bn[base($0)] = 1; next }
	/^!_/ { next }
	{
		k = fld("kind")
		if (k == "mention") { m[++nm] = $1 "\t" $2 "\t" fld("line"); next }
		if (isdoc(k) || k == "file") next
		def[$1] = 1; def[lastseg($1)] = 1
	}
	END {
		for (i = 1; i <= nm; i++) {
			split(m[i], a, "\t"); n = a[1]
			if ((n in def) || (lastseg(n) in def) || (n in path) || (n in bn)) continue
			print m[i]
		}
	}' "$STATE/listing" "$TAGS" >"$T/cand"
	# Literal resolution: every word in code, split three ways (identifier,
	# dotted name, path), so a mention found verbatim counts. One pass with tr;
	# grep -F -f with thousands of patterns takes minutes on BSD grep.
	# The big sort runs once, on the widest split; the narrower splits are
	# derived from its unique words.
	: >"$T/found"
	if [ -s "$T/cand" ]; then
		xfiles "$T/code" cat 2>/dev/null | tr -cs 'A-Za-z0-9_./-' '\n' | sort -u >"$T/words" || :
		{
			cat "$T/words"
			tr -cs 'A-Za-z0-9_.' '\n' <"$T/words"
			tr -cs 'A-Za-z0-9_' '\n' <"$T/words"
		} | sed 's#[./-]*$##' | sort -u >"$T/found"
	fi
	awk -F'\t' 'FILENAME == ARGV[1] { f[$0] = 1; next }
		!($1 in f) { n++; if (n <= 200) printf "check     %s:%s  %s\n", $2, $3, $1 }
		END {
			if (n > 200) printf "check     +%d more\n", n - 200
			printf "unresolved %d live-doc mentions match no definition, path or code literal: a list to check, not a stale verdict\n", n
		}' "$T/found" "$T/cand"
}

q_trace() {
	cur=$REL
	seen=" "
	while :; do
		anchor=
		case $cur in *'#'*) anchor=" (#${cur#*#})"; cur=${cur%%#*} ;; esac
		if [ ! -f "$cur" ]; then
			echo "trace     broken link: $cur$anchor"
			return 0
		fi
		line=$(awk '
			FNR == 1 { infm = ($0 == "---"); if (!infm) exit; next }
			infm && $0 == "---" { exit }
			/^id:/ { v = $0; sub(/^id:[ \t]*/, "", v); id = v }
			/^title:/ { v = $0; sub(/^title:[ \t]*/, "", v); gsub(/^"|"$/, "", v); title = v }
			/^intent:/ { v = $0; sub(/^intent:[ \t]*/, "", v); intent = v }
			END { print (id != "" ? id : FILENAME) "\t" intent "\t" title }' "$cur")
		id=$(printf '%s' "$line" | cut -f1)
		intent=$(printf '%s' "$line" | cut -f2)
		title=$(printf '%s' "$line" | cut -f3)
		if [ -n "$intent" ]; then
			echo "trace     $id$anchor: $intent"
		else
			echo "trace     $id$anchor: no intent line${title:+ · (title) $title}"
		fi
		parent=$(awk -v key=relates "$AWK_FMLIST" "$cur" | cut -f2 | grep -v -E '(^|/)adr/' | head -n 1) || :
		[ -n "$parent" ] || return 0
		case $seen in *" $parent "*) echo "trace     cycle at $parent"; return 0 ;; esac
		seen="$seen$parent "
		cur=$parent
	done
}

case $Q in
def) q_def ;;
docs) q_docs ;;
module) q_module ;;
file) q_file ;;
unresolved) q_unresolved ;;
trace) q_trace ;;
esac
